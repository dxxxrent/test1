{
  "name": "codebuddy-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user government document writing workbench bridge",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "predev": "node scripts/patch-codebuddy-reasoning.cjs",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/patch-codebuddy-reasoning.cjs",
    "build": "tsc -p tsconfig.json",
    "prestart": "node scripts/patch-codebuddy-reasoning.cjs",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "diagnostics:dump": "tsx scripts/dump-project-diagnostics.ts",
    "cleanup:redboxed": "tsx scripts/cleanup-redboxed-projects.ts",
    "e2e:capture": "node scripts/capture-generation.mjs",
    "e2e:product": "node scripts/verify-document-product.mjs",
    "e2e:finish": "node scripts/finish-generation-capture.mjs",
    "evidence:enrich": "node scripts/enrich-generation-evidence.mjs"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.258",
    "pg": "^8.23.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
